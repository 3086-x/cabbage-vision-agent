# 复制成 .env 后填值；程序不自动加载 .env，请用 dotenv 或直接 export。
# 之所以不做自动加载：环境变量来源应当是显式的，隐式读 .env 会让
# "为什么线上用的是另一个 key" 变成难查的问题。

# ---- LLM（四选一，或自定义兼容网关）----
# auto 会按 DASHSCOPE → DEEPSEEK → OPENAI → MOONSHOT 的顺序挑第一个有 key 的
CVAGENT_LLM=auto

DASHSCOPE_API_KEY=
OPENAI_API_KEY=
DEEPSEEK_API_KEY=
MOONSHOT_API_KEY=

# 任意 OpenAI 兼容网关（中转/自建/本地 vLLM）
# CVAGENT_LLM=custom
# CVAGENT_BASE_URL=https://your-gateway.example.com/v1
# CVAGENT_API_KEY=sk-xxx

# 境外端点常需代理；国内端点直连更快，所以按需设置
# CVAGENT_PROXY=http://127.0.0.1:7897

CVAGENT_MODEL=
CVAGENT_TEMPERATURE=0.0
# 读超时（秒）。默认 120：推理型模型带思维链时首字响应常超过 60s，
# 卡在 60 会让正常请求被当成网络故障、白重试三轮。
CVAGENT_LLM_TIMEOUT=120

# 百炼的模型名更新很快，且免费额度**按模型分别发放**——
# 某个模型报 403 FreeTierOnly 不代表 key 无效，只代表这个模型的额度用完了。
# 用 `cvagent models` 列出当前账户可用的模型，再填到 CVAGENT_MODEL。
# 已验证支持 function calling 的例子：qwen3.8-flash / qwen3.8-27b /
# qwen3.8-max-0902 / deepseek-v4.1-flash / kimi-k3 / glm-5.3

# ---- 推理 ----
CVAGENT_WEIGHTS=weights/best.pt
CVAGENT_DEVICE=cpu          # cpu | cuda:0 | mps
CVAGENT_IMGSZ=1024
CVAGENT_CONF=0.25

# ---- Agent 循环 ----
CVAGENT_MAX_STEPS=8
CVAGENT_MAX_TOOL_CHARS=1400
CVAGENT_MAX_HISTORY=6
